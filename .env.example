# Required for live model use. Keep the real key out of source control.
OPENROUTER_API_KEY=

# Set to 1 for the five recorded synthetic demo questions. No provider key is needed.
ORBITDESK_DEMO_MODE=0

# Development defaults to artifacts/orbitdesk-v2.sqlite3 if unset. For PostgreSQL,
# use postgresql+psycopg://user:password@host:5432/orbitdesk and run Alembic.
ORBITDESK_DATABASE_URL=
# Docker Compose demo requires ORBITDESK_POSTGRES_PASSWORD in your shell or .env.
ORBITDESK_POSTGRES_PASSWORD=

# Production requires PostgreSQL, a model key, an origin, and demo mode off.
ORBITDESK_ENV=development

# Shared operator gate for a private demo. Production requires 24+ characters.
# Keep this server-side; enter it in the browser access form when prompted.
ORBITDESK_OPERATOR_TOKEN=
# Policy used by the explicit dry-run/apply retention command. No automatic deletion.
ORBITDESK_RETENTION_DAYS=30

# OpenRouter does not list a Z.ai GLM 3.5 model. This is the closest likely intent.
OPENROUTER_MODEL=z-ai/glm-4.5-air
OPENROUTER_REQUEST_TIMEOUT_SECONDS=20
OPENROUTER_TOTAL_TIMEOUT_SECONDS=45
OPENROUTER_MAX_ATTEMPTS=3

# Optional OpenRouter app attribution.
OPENROUTER_APP_URL=http://localhost
OPENROUTER_APP_TITLE=OrbitDesk Support Agent

# Bounded model inputs and outputs.
ORBITDESK_MAX_LLM_INPUT_CHARS=16000
ORBITDESK_MAX_OUTPUT_TOKENS=768

# Operator-owned retrieval policy. End users do not select this in the UI.
# Use semantic only after installing the optional semantic dependencies.
ORBITDESK_RETRIEVAL_MODE=keyword

# Browser/API integration.
ORBITDESK_WORKFLOW_TIMEOUT_SECONDS=60
ORBITDESK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
